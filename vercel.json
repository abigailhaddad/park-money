{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "park-money.vercel.app"
        }
      ],
      "destination": "https://park-money.abigailhaddad.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "park-money.vercel.app"
        }
      ],
      "destination": "https://park-money.abigailhaddad.com/:path*",
      "permanent": false
    }
  ]
}
